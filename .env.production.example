# Backend only. Copy to an ignored .env.production or use host secret settings.
NODE_ENV=production
PORT=3001
APP_URL=https://quecare.example.com
ALLOW_DEMO_LOGIN=false
# Use a dedicated production project, never the development database.
# Session pooler on 5432 supports IPv4; copy the actual string from Supabase.
# URL-encode the password. Use verify-full and the provider CA if required.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=quecare-private
EMAIL_PROVIDER=resend
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
# Domain-free prototype only: QueCare <onboarding@resend.dev> (Resend account owner recipient only).
EMAIL_FROM=QueCare <noreply@example.com>
# Optional; omit to preserve the existing approved-information fallback.
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Provisioning only. Remove all three after npm run db:bootstrap.
# INITIAL_ADMIN_NAME=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
