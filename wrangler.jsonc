{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quecare",
  "main": "deploy/cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
