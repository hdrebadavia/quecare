{
  "name": "quecare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate": "tsx server/migrate.ts",
    "db:secure:supabase": "tsx scripts/secure-supabase.ts",
    "db:seed": "tsx server/seed.ts",
    "setup": "npm run db:local && npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:integration": "RUN_DB_TESTS=1 vitest run tests/integration.test.ts",
    "verify:browser": "tsx scripts/verify-browser.ts",
    "db:bootstrap": "tsx scripts/bootstrap.ts",
    "verify:production": "tsx scripts/verify-production.ts",
    "check:worker": "tsc -p deploy/cloudflare/tsconfig.json",
    "check:deployment": "node scripts/check-deployment.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "preview:cloudflare": "npm run build && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev",
    "deploy:cloudflare": "npm run build && npm run check:worker && wrangler deploy",
    "check:cloudflare": "npm run check:worker && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "vitest": "^5.0.5",
    "wrangler": "^4.161.0"
  }
}
